# ===================================================
# Variables de entorno para Empáticos API
# ===================================================

# Puerto en el que se ejecuta el servidor Express
PORT=5000

# Cadena de conexión a base de datos remota MongoDB Atlas mediante Mongoose
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/empaticos_db?retryWrites=true&w=majority

# Correo electrónico único autorizado con permisos de administrador
ADMIN_EMAIL=matiitoorres06@gmail.com

# ID del proyecto de Firebase Authentication utilizado para validar tokens
FIREBASE_PROJECT_ID=empaticosbd
