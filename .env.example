# ── Backend ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Firestore (Paso 3) ──────────────────────────────────────
# Definí UNA de las dos:
# FIREBASE_SERVICE_ACCOUNT=<JSON de la cuenta de servicio en base64>
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/service-account.json

# ── Cloudinary (Paso 3) ─────────────────────────────────────
# Las tres son necesarias para activar Cloudinary
# CLOUDINARY_CLOUD_NAME=tu-cloud
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# ── Autenticación del Admin (Paso 3) ────────────────────────
# true = Firebase Auth (producción), false = contraseña simple (desarrollo)
FIREBASE_AUTH_ENABLED=false

# Contraseña para modo desarrollo
ADMIN_PASSWORD=EMpaticos2025arg

# Secret para JWT en modo desarrollo (generar uno aleatorio)
JWT_SECRET=change-this-to-a-random-secret-string

# ── Frontend (VITE_*) ───────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_FIREBASE_AUTH_ENABLED=false
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
